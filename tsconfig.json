{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["utils/*"],
      "@utils": ["utils/index.ts"],
      "@samples/*": ["samples/*"]
    }
  },
  "include": ["packages/**/*", "utils/**/*"],
  "exclude": ["node_modules", "dist"]
}
