{
  "name": "@vue3-office/vue-audio",
  "version": "1.0.0",
  "description": "Audio component for Vue 3",
  "author": {
    "name": "LayHuts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LayHuts/vue3-office.git",
    "directory": "packages/vue-audio"
  },
  "homepage": "https://github.com/LayHuts/vue3-office",
  "bugs": {
    "url": "https://github.com/LayHuts/vue3-office/issues"
  },
  "license": "MIT",
  "keywords": [
    "audio",
    "player",
    "vue",
    "music",
    "vue3"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/index.umd.js",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:dts",
    "build:lib": "vite build",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "peerDependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/colorthief": "^2.6.0",
    "hls.js": "^1.6.5"
  },
  "dependencies": {
    "@vue3-office/common": "workspace:*",
    "colorthief": "^2.6.0"
  }
}
