{
  "name": "@vue3-office/vue-video",
  "version": "1.0.0",
  "description": "Video component for Vue 3",
  "author": {
    "name": "LayHuts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LayHuts/vue3-office.git",
    "directory": "packages/vue-video"
  },
  "homepage": "https://github.com/LayHuts/vue3-office",
  "bugs": {
    "url": "https://github.com/LayHuts/vue3-office/issues"
  },
  "license": "MIT",
  "keywords": [
    "video",
    "player",
    "vue",
    "xgplayer"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/index.umd.js",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:dts",
    "build:lib": "vite build",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "peerDependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {

  },
  "dependencies": {
    "@vue3-office/common": "workspace:*",
    "xgplayer": "^3.0.23",
    "xgplayer-music": "^3.0.23"
  }
}
