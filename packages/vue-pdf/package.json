{
  "name": "@vue3-office/vue-pdf",
  "version": "1.0.2",
  "description": "PDF component for Vue 3",
  "author": {
    "name": "LayHuts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LayHuts/vue3-office.git",
    "directory": "packages/vue-pdf"
  },
  "homepage": "https://github.com/LayHuts/vue3-office",
  "bugs": {
    "url": "https://github.com/LayHuts/vue3-office/issues"
  },
  "license": "MIT",
  "keywords": [
    "pdf",
    "vue",
    "viewer"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./src/*": "./src/*"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:dts",
    "build:lib": "vite build",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "peerDependencies": {
    "vue": "^3.5.24"
  },
  "dependencies": {
    "@vue3-office/common": "workspace:*",
    "pdfjs-dist": "5.7.284"
  }
}
