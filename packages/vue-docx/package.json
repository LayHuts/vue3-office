{
  "name": "@vue3-office/vue-docx",
  "version": "1.0.1",
  "description": "Docx component for Vue 3",
  "author": {
    "name": "LayHuts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LayHuts/vue3-office.git",
    "directory": "packages/vue-docx"
  },
  "homepage": "https://github.com/LayHuts/vue3-office",
  "bugs": {
    "url": "https://github.com/LayHuts/vue3-office/issues"
  },
  "license": "MIT",
  "keywords": [
    "docx",
    "word",
    "vue",
    "viewer"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm build:lib && pnpm build:dts",
    "build:lib": "vite build",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "peerDependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "less": "^4.2.0"
  },
  "dependencies": {
    "@vue3-office/common": "workspace:*",
    "docx-preview": "^0.3.7"
  }
}
