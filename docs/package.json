{
  "name": "vue-pdf-docs",
  "version": "1.0.0",
  "description": "vue-pdf docs",
  "private": true,
  "scripts": {
    "dev": "vitepress dev .",
    "build": "pnpm patch && vitepress build --clean-temp --clean-cache .",
    "patch": "replace-in-file 'pdfjs-dist' 'pdfjs-dist/legacy/build/pdf.mjs' ../packages/vue-pdf/dist/index.mjs"
  },
  "dependencies": {
    "@vue3-office/vue-pdf": "workspace:*"
  },
  "devDependencies": {
    "sass": "^1.77.2",
    "vitepress": "^1.6.4",
    "replace-in-file": "^8.3.0"
  }
}
