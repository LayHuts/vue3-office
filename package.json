{
  "name": "vue3-office",
  "version": "1.0.0",
  "description": "vue3-office",
  "author": {
    "name": "LayHuts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LayHuts/vue3-office.git"
  },
  "homepage": "https://github.com/LayHuts/vue3-office",
  "bugs": {
    "url": "https://github.com/LayHuts/vue3-office/issues"
  },
  "license": "MIT",
  "keywords": [
    "audio",
    "pdf",
    "excel",
    "world",
    "audio",
    "player",
    "vue",
    "music",
    "vue3"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @vue3-office/playground dev",
    "build:playground": "pnpm --filter @vue3-office/playground build",
    "build:common": "pnpm --filter @vue3-office/common build",
    "build:pdf": "pnpm --filter @vue3-office/vue-pdf build",
    "build:docx": "pnpm --filter @vue3-office/vue-docx build",
    "build:excel": "pnpm --filter @vue3-office/vue-excel build",
    "build:video": "pnpm --filter @vue3-office/vue-video build",
    "build:audio": "pnpm --filter @vue3-office/vue-audio build",
    "build:all": "pnpm build:common && pnpm build:pdf && pnpm build:docx && pnpm build:excel && pnpm build:video && pnpm build:audio",
    "publish:common": "pnpm --filter @vue3-office/common publish --access public --no-git-checks",
    "publish:pdf": "pnpm --filter @vue3-office/vue-pdf publish --access public --no-git-checks",
    "publish:pdf:alpha": "pnpm --filter @vue3-office/vue-pdf publish --access public --no-git-checks --tag alpha",
    "publish:docx": "pnpm --filter @vue3-office/vue-docx publish --access public --no-git-checks",
    "publish:excel": "pnpm --filter @vue3-office/vue-excel publish --access public --no-git-checks",
    "publish:video": "pnpm --filter @vue3-office/vue-video publish --access public --no-git-checks",
    "publish:audio": "pnpm --filter @vue3-office/vue-audio publish --access public --no-git-checks",
    "publish:all": "pnpm build:all && pnpm publish:common && pnpm publish:pdf && pnpm publish:docx && pnpm publish:excel && pnpm publish:video && pnpm publish:audio",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "eslint": "^9.28.0",
    "eslint-plugin-vue": "^10.8.0",
    "typescript": "~5.7.0",
    "vite": "^7.1.9",
    "vue": "^3.5.24",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.22.0"
}
